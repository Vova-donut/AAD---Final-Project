# npm run setup generates .env, private keys and a local HTTPS certificate.
PORT=3443
APP_ORIGIN=https://localhost:3443
MONGODB_URI=mongodb://127.0.0.1:27017/study_planner
JWT_SECRET=generated-by-setup
SUBSCRIPTION_KEY=generated-by-setup
VAPID_PUBLIC_KEY=generated-by-setup
VAPID_PRIVATE_KEY=generated-by-setup
VAPID_SUBJECT=mailto:student@example.com
TLS_KEY=.local/localhost-key.pem
TLS_CERT=.local/localhost.pem
